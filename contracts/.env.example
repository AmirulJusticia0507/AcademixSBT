# =============================================================================
# AcademixSBT — Environment untuk Deploy Smart Contract (Testnet)
# Salin ke .env dan isi nilai sebenarnya. Jangan commit .env!
# =============================================================================

# Kunci privat wallet deployer (harus memiliki native coin uji coba: MATIC di Amoy / ETH di Sepolia)
PRIVATE_KEY=0xyour_private_key_here

# RPC Polygon Amoy (testnet) — gunakan endpoint pribadi (Alchemy / Infura / QuickNode) agar stabil
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY

# RPC Arbitrum Sepolia (testnet)
ARBITRUM_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# (Opsional) Alamat wallet institusi tambahan yang didaftarkan sebagai issuer saat deploy
ISSUER_ADDRESS=0xYourIssuerAddressHere
