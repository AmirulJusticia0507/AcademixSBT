# ==== Server ====
PORT=4000
# URL publik backend (dipakai untuk link lokal IPFS saat provider=local)
PUBLIC_API_URL="http://localhost:4000"
# Lindungi endpoint mint/revoke. Ganti untuk demo/production.
ADMIN_API_KEY="dev-admin-key"
# Opsional: API key khusus HRD untuk POST /api/verify/batch (default: ADMIN_API_KEY)
VERIFIER_API_KEY=""

# ==== Database ====
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academix"

# ==== Blockchain ====
RPC_URL="https://rpc-amoy.polygon.technology"
CHAIN_ID=80002
CONTRACT_ADDRESS=""
PRIVATE_KEY=""
# Opsional: wallet institusi yang dipakai saat minting (default: PRIVATE_KEY)
ISSUER_ADDRESS=""

# ==== IPFS ====
# pinata | local
IPFS_PROVIDER="local"
IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs"
# Untuk IPFS_PROVIDER=pinata
PINATA_JWT=""
PINATA_API_KEY=""
PINATA_SECRET_KEY=""
# Folder penyimpanan metadata saat IPFS_PROVIDER=local
LOCAL_IPFS_DIR="./storage/ipfs"
